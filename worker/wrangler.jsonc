{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyg-notes",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://notes.andstuff.dev",
    "GOATCOUNTER_URL": "https://nyg-notes.goatcounter.com"
  }
}
